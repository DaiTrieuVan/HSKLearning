# ---------------------------------------------------------------------------
# Copy this file to backend/.env and fill in the real values.
# backend/.env is git-ignored; never commit secrets.
#
# Setup the database with (run once as root in MySQL Workbench):
#   source database/setup-local.sql
# ---------------------------------------------------------------------------

# --- Application datasource (MySQL 8+ / MySQL 26, NOT the MariaDB in XAMPP) ---
DB_URL=jdbc:mysql://localhost:3306/hsk_learning?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8
DB_USERNAME=hsk_app
DB_PASSWORD=change-me

# --- Test datasource (rebuilt by Flyway on every test run) ---
# Leave empty to reuse the credentials above with the URL below.
TEST_DB_URL=jdbc:mysql://localhost:3306/hsk_learning_test?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8
TEST_DB_USERNAME=
TEST_DB_PASSWORD=

# --- CORS: comma separated list of frontend origins ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
