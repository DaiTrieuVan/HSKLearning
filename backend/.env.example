# ---------------------------------------------------------------------------
# Copy this file to backend/.env and fill in the real values.
# backend/.env is git-ignored; never commit secrets.
#
# Properties are read with spring.config.import (application.yaml), which
# parses this as a Java .properties file: write KEY=value, do NOT wrap values
# in quotes and do not use "export".
#
# Provision the database first: run database/setup-local.sql in MySQL Workbench
# (needs an administrator account) and keep @app_password there equal to
# DB_PASSWORD below.
# ---------------------------------------------------------------------------

# --- Application datasource (MySQL 8+/26 on port 3306) ---
# NOT the MariaDB shipped with XAMPP: Hibernate 7.4 requires MariaDB >= 10.6.
DB_URL=jdbc:mysql://localhost:3306/hsk_learning?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8
DB_USERNAME=hsk_app
DB_PASSWORD=HskDev2026!

# --- Test datasource ---
# The test suite cleans and re-migrates this schema on every run. It reuses the
# username and password above, so only the URL is normally needed here.
TEST_DB_URL=jdbc:mysql://localhost:3306/hsk_learning_test?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8

# --- CORS: comma separated list of frontend origins ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
