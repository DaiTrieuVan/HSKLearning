ry x="70" y="702" width="300" height="120" as="geometry" /></mxCell><mxCell id="e11" value="&lt;b&gt;assignment_questions&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;FK assignment_id&lt;br/&gt;snapshot" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#ffe4e6;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="480" y="702" width="300" height="120" as="geometry" /></mxCell><mxCell id="e12" value="&lt;b&gt;attempts&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;FK assignment_id&lt;br/&gt;FK student_id" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#ffe4e6;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="890" y="702" width="300" height="120" as="geometry" /></mxCell><mxCell id="e13" value="&lt;b&gt;attempt_answers&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;FK attempt_id&lt;br/&gt;FK assignment_question_id" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#ffe4e6;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="70" y="897" width="300" height="120" as="geometry" /></mxCell><mxCell id="e14" value="&lt;b&gt;score_adjustments&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;FK attempt_id" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#ffe4e6;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="480" y="897" width="300" height="118" as="geometry" /></mxCell><mxCell id="e15" value="&lt;b&gt;lesson_progress&lt;/b&gt;&lt;hr/&gt;PK user_id&lt;br/&gt;PK lesson_id" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#ccfbf1;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="890" y="897" width="300" height="118" as="geometry" /></mxCell><mxCell id="l0" value="1:N giáo viên" style="edge