oundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e3" target="e6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l6" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e1" target="e7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l7" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e1" target="e8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l8" value="1:0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e1" target="e9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verbal_note_erd-7" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:14px;&quot;&gt;TIẾN ĐỘ VÀ TÍNH NĂNG SAU MVP&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.65;&quot;&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• lesson_progress lưu một lần hoàn thành cho mỗi cặp (học sinh, bài học).&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• vocab_learning (Sau) lưu lịch ôn từ theo SRS; review_logs (Sau) ghi từng lần ôn.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• daily_goals (Sau) tổng hợp hoạt động theo ngày Việt Nam; mỗi người một bản ghi mỗi ngày.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• xp_events (Sau) ghi nguồn cộng điểm XP để tránh cộng trùng.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• user_gamification (Sau) tổng hợp XP, cấp độ và streak để hiển thị nhanh.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• Các bảng đánh dấu (Sau) là phần mở rộng, không cần triển khai trong MVP đầu tiên.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;align=left;verticalAlign=top;spacing=18;shadow=0;" vertex="1" parent="1"><mxGeometry x="1280" y="95" width="540" height="730" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>