ll=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e1" target="e8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l6" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e1" target="e9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l7" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e9" target="e10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l8" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e2" target="e10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l9" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e10" target="e11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l10" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e10" target="e12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l11" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e12" target="e13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l12" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e12" target="e14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l13" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e1" target="e15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l14" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e6" target="e15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verbal_note_erd-1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:14px;&quot;&gt;BỨC TRANH TỔNG THỂ&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.65;&quot;&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• Hệ thống gồm 3 vai trò: Admin, Giáo viên và Học sinh. Một người dùng có thể mang nhiều vai trò.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• Giáo viên tạo lớp; học sinh tham gia thông qua class_members. Mỗi lớp thuộc một cấp HSK mục tiêu.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• Học liệu đi theo chương trình HSK → cấp độ → bài học → từ vựng.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• Giáo viên soạn câu hỏi, gom thành bài tập (exercise), rồi giao thành assignment cho từng lớp.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• Học sinh thực hiện attempt; câu trả lời và điểm được lưu theo từng lượt. Bảng điểm lấy lượt hợp lệ cao nhất.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• Sơ đồ tổng quan lược bớt bảng phụ; xem các trang tiếp theo để hiểu đầy đủ quan hệ.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;align=left;verticalAlign=top;spacing=18;shadow=0;" vertex="1" parent="1"><mxGeometry x="1280" y="95" width="540" height="730" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="erd-2" name="02 - Tài khoản &amp; phân quyền"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="e1" value="&lt;b&gt;users&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;email [unique]&lt;br/&gt;password_hash&lt;br/&gt;full_name, avatar_url&lt;br/&gt;status, failed_login_count&lt;br/&gt;locked_until, last_mode&lt;br/&gt;created_at, updated_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#dbeafe;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="70" y="95" width="300" height="216" as="geometry" /></mxCell><mxCell id="e2" value="&lt;b&gt;roles&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;code [unique]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#dbeafe;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="480" y="95" width="300" height="118" as="geometry" /></mxCell><mxCell id="e3" value="&lt;b&gt;user_roles&lt;/b&gt;&lt;hr/&gt;PK/FK user_id&lt;br/&gt;PK/FK role_id&lt;br/&gt;FK granted_by → users&lt;br/&gt;granted_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#dbeafe;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="890" y="95" width="300" height="144" as="geometry" /></mxCell><mxCell id="e4" value="&lt;b&gt;teacher_requests&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;FK user_id&lt;br/&gt;teaching_info&lt;br/&gt;status&lt;br/&gt;FK reviewed_by → users&lt;br/&gt;reviewed_at, reject_reason&lt;br/&gt;created_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#dbeafe;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="70" y="386" width="300" height="216" as="geometry" /></mxCell><mxCell id="e5" value="&lt;b&gt;password_reset_tokens&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;FK user_id&lt;br/&gt;token_hash&lt;br/&gt;expires_at, used_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#dbeafe;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="480" y="386" width="300" height="144" as="geometry" /></mxCell><mxCell id="e6" value="&lt;b&gt;audit_logs&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;FK actor_id → users (nullable)&lt;br/&gt;action, entity_type, entity_id&lt;br/&gt;detail (JSON)&lt;br/&gt;created_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#dbeafe;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="890" y="386" width="300" height="168" as="geometry" /></mxCell><mxCell id="l0" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e1" target="e3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l1" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e2" target="e3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l2" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e1" target="e4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l3" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e1" target="e5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l4" value="1:N (optional)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e1" target="e6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verbal_note_erd-2" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:14px;&quot;&gt;TÀI KHOẢN VÀ QUYỀN&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.65;&quot;&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• users lưu thông tin đăng nhập và trạng thái tài khoản; roles định nghĩa ADMIN / TEACHER / STUDENT.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• user_roles là bảng trung gian N–N: một người có thể vừa là giáo viên vừa là học sinh.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• Người đăng ký được cấp STUDENT. teacher_requests lưu hồ sơ xin quyền TEACHER và kết quả duyệt.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• password_reset_tokens hỗ trợ đặt lại mật khẩu, chỉ lưu mã token đã băm.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• audit_logs ghi lại hành động quan trọng; actor_id có thể trống với sự kiện do hệ thống tạo.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• last_mode chỉ điều khiển giao diện; quyền truy cập luôn được kiểm tra ở máy chủ.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;align=left;verticalAlign=top;spacing=18;shadow=0;" vertex="1" parent="1"><mxGeometry x="1280" y="95" width="540" height="730" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="erd-3" name="03 - Lớp học"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="e1" value="&lt;b&gt;users&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;full_name&lt;br/&gt;roles qua user_roles" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#dbeafe;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="70" y="95" width="300" height="120" as="geometry" /></mxCell><mxCell id="e2" value="&lt;b&gt;classes&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;FK teacher_id → users&lt;br/&gt;FK hsk_level_id → hsk_levels&lt;br/&gt;name, description&lt;br/&gt;join_code [unique]&lt;br/&gt;status ACTIVE / ARCHIVED" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#dcfce7;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="480" y="95" width="300" height="192" as="geometry" /></mxCell><mxCell id="e3" value="&lt;b&gt;class_members&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;FK class_id → classes&lt;br/&gt;FK student_id → users&lt;br/&gt;status ACTIVE / LEFT / REMOVED&lt;br/&gt;joined_at, left_at&lt;br/&gt;unique(class_id, student_id)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#dcfce7;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="890" y="95" width="300" height="192" as="geometry" /></mxCell><mxCell id="e4" value="&lt;b&gt;class_member_events&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;FK member_id → class_members&lt;br/&gt;FK actor_id → users&lt;br/&gt;event JOINED/LEFT/REMOVED/RESTORED&lt;br/&gt;created_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#dcfce7;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="70" y="362" width="300" height="168" as="geometry" /></mxCell><mxCell id="e5" value="&lt;b&gt;hsk_levels&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;FK program_id&lt;br/&gt;name" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="480" y="362" width="300" height="120" as="geometry" /></mxCell><mxCell id="e6" value="&lt;b&gt;class_vocab_sets&lt;/b&gt;&lt;hr/&gt;PK class_id&lt;br/&gt;PK set_id&lt;br/&gt;FK assigned_by → users&lt;br/&gt;assigned_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="890" y="362" width="300" height="144" as="geometry" /></mxCell><mxCell id="e7" value="&lt;b&gt;vocab_sets&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;FK owner_id → users&lt;br/&gt;name" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="70" y="605" width="300" height="120" as="geometry" /></mxCell><mxCell id="l0" value="1:N phụ trách" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e1" target="e2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l1" value="1:N tham gia" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e1" target="e3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l2" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e2" target="e3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l3" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e3" target="e4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l4" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e5" target="e2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l5" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e2" target="e6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l6" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e7" target="e6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verbal_note_erd-3" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:14px;&quot;&gt;VÒNG ĐỜI LỚP HỌC&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.65;&quot;&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• Một users (giáo viên) có thể phụ trách nhiều classes; mỗi lớp có đúng một giáo viên chính.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• class_members nối học sinh với lớp, đồng thời lưu ACTIVE / LEFT / REMOVED.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• Một cặp (class_id, student_id) chỉ có một bản ghi thành viên; vào lại là đổi trạng thái, không tạo trùng.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• class_member_events lưu các sự kiện JOINED, LEFT, REMOVED, RESTORED để không mất lịch sử.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• Lớp ACTIVE có thể nhận học sinh và giao bài; lớp ARCHIVED chỉ xem lại.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• Học sinh bị REMOVED chỉ được khôi phục bởi giáo viên; kết quả đã nộp vẫn được giữ.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;align=left;verticalAlign=top;spacing=18;shadow=0;" vertex="1" parent="1"><mxGeometry x="1280" y="95" width="540" height="730" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="erd-4" name="04 - Học liệu HSK"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="e1" value="&lt;b&gt;hsk_programs&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;code, version&lt;br/&gt;name, is_active" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="70" y="95" width="300" height="120" as="geometry" /></mxCell><mxCell id="e2" value="&lt;b&gt;hsk_levels&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;FK program_id&lt;br/&gt;name, sort_order, is_hidden" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="480" y="95" width="300" height="120" as="geometry" /></mxCell><mxCell id="e3" value="&lt;b&gt;lessons&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;FK level_id&lt;br/&gt;title, description&lt;br/&gt;sort_order, is_hidden" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="890" y="95" width="300" height="144" as="geometry" /></mxCell><mxCell id="e4" value="&lt;b&gt;grammar_points&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;FK lesson_id&lt;br/&gt;title, explanation, sort_order" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="70" y="314" width="300" height="120" as="geometry" /></mxCell><mxCell id="e5" value="&lt;b&gt;grammar_examples&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;FK grammar_point_id&lt;br/&gt;hanzi, pinyin, meaning&lt;br/&gt;sort_order" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="480" y="314" width="300" height="144" as="geometry" /></mxCell><mxCell id="e6" value="&lt;b&gt;vocabularies&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;FK owner_id → users (nullable)&lt;br/&gt;scope SYSTEM / TEACHER&lt;br/&gt;hanzi, pinyin, meaning&lt;br/&gt;example, audio_url, is_hidden&lt;br/&gt;owner_key [derived]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="890" y="314" width="300" height="192" as="geometry" /></mxCell><mxCell id="e7" value="&lt;b&gt;lesson_vocabularies&lt;/b&gt;&lt;hr/&gt;PK/FK lesson_id&lt;br/&gt;PK/FK vocabulary_id&lt;br/&gt;sort_order" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="70" y="581" width="300" height="120" as="geometry" /></mxCell><mxCell id="e8" value="&lt;b&gt;vocab_sets&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;FK owner_id → users&lt;br/&gt;name, is_hidden" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="480" y="581" width="300" height="120" as="geometry" /></mxCell><mxCell id="e9" value="&lt;b&gt;vocab_set_items&lt;/b&gt;&lt;hr/&gt;PK/FK set_id&lt;br/&gt;PK/FK vocabulary_id&lt;br/&gt;sort_order" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="890" y="581" width="300" height="120" as="geometry" /></mxCell><mxCell id="e10" value="&lt;b&gt;class_vocab_sets&lt;/b&gt;&lt;hr/&gt;PK/FK class_id&lt;br/&gt;PK/FK set_id&lt;br/&gt;FK assigned_by&lt;br/&gt;assigned_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="70" y="776" width="300" height="144" as="geometry" /></mxCell><mxCell id="e11" value="&lt;b&gt;classes&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;FK teacher_id" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#dcfce7;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="480" y="776" width="300" height="118" as="geometry" /></mxCell><mxCell id="e12" value="&lt;b&gt;users&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;full_name" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#dbeafe;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="890" y="776" width="300" height="118" as="geometry" /></mxCell><mxCell id="l0" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e1" target="e2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l1" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e2" target="e3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l2" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e3" target="e4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l3" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e4" target="e5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l4" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e3" target="e7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l5" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e6" target="e7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l6" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e8" target="e9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l7" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e6" target="e9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l8" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e11" target="e10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l9" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e8" target="e10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l10" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e12" target="e8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l11" value="1:N (optional)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;" edge="1" parent="1" source="e12" target="e6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verbal_note_erd-4" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:14px;&quot;&gt;HỌC LIỆU VÀ TỪ VỰNG&lt;/div&gt;&lt;div style=&quot;font-size:13px;line-height:1.65;&quot;&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• hsk_programs chứa phiên bản chương trình; mỗi chương trình có nhiều hsk_levels và mỗi cấp có nhiều lessons.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• grammar_points và grammar_examples lưu điểm ngữ pháp và ví dụ theo bài.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• vocabularies chứa từ dùng chung (owner_id rỗng) hoặc từ riêng của giáo viên (owner_id có giá trị).&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• lesson_vocabularies giải quyết quan hệ N–N: một từ xuất hiện ở nhiều bài và một bài có nhiều từ.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• vocab_sets là bộ từ do giáo viên tạo; vocab_set_items nối bộ với các từ.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• class_vocab_sets cho phép một bộ từ được gắn cho nhiều lớp mà không nhân bản nội dung.&lt;/div&gt;&lt;div style=&quot;margin-bottom:12px;&quot;&gt;• Nội dung đã được sử dụng nên ẩn thay vì xóa cứng; quyền sở hữu được kiểm tra ở service.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;align=left;verticalAlign=top;spacing=18;shadow=0;" vertex="1" parent="1"><mxGeometry x="1280" y="95" width="540" height="825" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="erd-5" name="05 - Ngân hàng câu hỏi"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="e1" value="&lt;b&gt;users&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;full_name" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#dbeafe;strokeColor=#64748b;fontColor=#172033;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="70" y="95" width="300" height="118" as="geometry" /></mxCell><mxCell id="e2" value="&lt;b&gt;questions&lt;/b&gt;&lt;hr/&gt;PK id&lt;br/&gt;FK owner_id → users&lt;br/&gt;type MCQ/FILL/MATCH/ORDER&lt;br/&gt;content, explanation&lt;br/&gt;payload (structured)&lt;br/&gt;is_hidden" style="rounded=1;whiteSpace=wrap;